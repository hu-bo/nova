# Public API origin. Empty means same-origin (recommended for deployment).
VITE_API_BASE_URL=
# Optional separate public SSE origin; empty follows the API origin.
VITE_SSE_BASE_URL=
# Public Auth Service API base, e.g. https://auth.example.com/api.
# Casdoor is used by default, including development.
VITE_AUTH_BASE_URL=https://auth.8and1.cn/api
VITE_AUTH_APP_NAME=nova
# Explicit local-only bypass; pair VITE_AUTH_MODE=dev with server AUTH_MODE=dev.
VITE_AUTH_MODE=casdoor
# Development/preview proxy, never embedded into the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:9203
