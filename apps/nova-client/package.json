{
  "name": "@nova/nova-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "tsx scripts/api-check.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "test": "vitest run",
    "check:build": "node scripts/check-build.mjs",
    "typecheck": "pnpm --filter @nova/casdoor build && pnpm --filter @nova/agent-ui-contracts build && pnpm api:generate && pnpm routes:generate && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && pnpm check:theme && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "routes:check": "node scripts/routes-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "5.9.1",
    "@nova/agent-ui-contracts": "workspace:*",
    "@nova/casdoor": "workspace:*",
    "@nova/chat-ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.34",
    "@tanstack/router-plugin": "1.168.36",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "^26.1.0",
    "orval": "8.30.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "vite": "8.2.2",
    "vitest": "^2.1.3"
  }
}
