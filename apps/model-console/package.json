{
  "name": "@nova/model-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nova/casdoor build && pnpm --filter @nova/agent-ui-contracts build && vite",
    "prebuild": "pnpm --filter @nova/agent-ui-contracts build && pnpm --filter @nova/casdoor build && pnpm api:generate",
    "build": "pnpm typecheck && vite build",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- openapi.json src/api/generated",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm routes:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm routes:generate && vitest run",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@heroui/react": "^3.2.0",
    "@heroui/styles": "^3.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@nova/agent-ui-contracts": "workspace:*",
    "@nova/casdoor": "workspace:^",
    "@tanstack/react-query": "^5.90.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zod": "4.0.0",
    "@tanstack/react-router": "1.170.33"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "orval": "^8.23.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.3",
    "@tanstack/router-cli": "1.167.34",
    "@tanstack/router-plugin": "1.168.36",
    "@vitejs/plugin-react": "4.7.0"
  }
}
