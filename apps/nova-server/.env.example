# Publish these values to the existing config-center nova-server/env entry.
# Use a dedicated database for nova-dsh; the old nova schema is incompatible.
DATABASE_URL=postgresql://nova:REPLACE_ME@postgres:5432/nova_dsh
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000

# Optional. Set all three required values to enable attachment uploads. The endpoint must be
# reachable by browsers, and the bucket CORS policy must allow PUT with Content-Type from the Nova web origin.
# MINIO_ENDPOINT=minio.example.com
# MINIO_ACCESS_KEY=REPLACE_ME
# MINIO_SECRET_KEY=REPLACE_ME
# MINIO_PORT=9000
# MINIO_USE_SSL=true
# MINIO_BUCKET=nova-attachments

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: stored model, SSH and Runner credentials depend on it.
MODEL_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

NODE_ENV=production
AUTH_MODE=casdoor
AUTH_SERVICE_URL=https://auth.8and1.cn
# Historical service uses ?token=. Prefer header when the service supports Bearer.
AUTH_SERVICE_TOKEN_TRANSPORT=query
AUTH_SERVICE_TIMEOUT_MS=5000

HOST=0.0.0.0
PORT=9203
ROLE=all
LOG_LEVEL=info
# Local production runs; Compose writes to its persistent /var/log/nova-server volume.
LOG_DIR=logs
SWAGGER_UI_ENABLED=false
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=30
SSE_QUEUE_FRAMES=256
SSE_QUEUE_BYTES=4194304
SSE_HEARTBEAT_MS=15000
