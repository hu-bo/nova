{
  "name": "@nova/nova-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "database",
    "docker-compose.yml",
    "scripts/check-deployment.mjs"
  ],
  "scripts": {
    "dev": "pnpm --filter @hquant/logger-js build && pnpm --filter @nova/casdoor build && pnpm --filter @nova/agent-ui-contracts build && tsx watch src/server.ts",
    "dev:worker": "pnpm --filter @hquant/logger-js build && pnpm --filter @nova/casdoor build && pnpm --filter @nova/agent-ui-contracts build && tsx watch src/worker.ts",
    "build": "pnpm --filter @hquant/logger-js build && pnpm --filter @nova/casdoor build && pnpm --filter @nova/agent-ui-contracts build && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src database",
    "openapi:export": "tsx src/scripts/openapi-export.ts",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate --config database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config database/drizzle.config.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@hquant/logger-js": "workspace:*",
    "@nnova/harness": "workspace:^",
    "@nova/agent-ui-contracts": "workspace:^",
    "@nova/casdoor": "workspace:*",
    "@nova/coding-harness": "workspace:^",
    "@nova/runner-sdk": "workspace:^",
    "@nova/tools": "workspace:^",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "minio": "^8.0.7",
    "pg": "^8.13.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.30.1",
    "eslint": "9.39.5",
    "tsx": "^4.19.2"
  }
}
