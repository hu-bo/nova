{
  "name": "@nova/chat-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "pnpm --filter @nnova/harness build && vite --config vite.config.ts demo --host 127.0.0.1 --port 4175",
    "build": "pnpm --filter @nnova/harness build && pnpm typecheck && vite build --config vite.config.ts demo",
    "typecheck": "tsc -p tsconfig.demo.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "candy-eval": "node example/candy-eval.mjs",
    "test": "vitest run packages/chat-ui/src",
    "generate:runner-protocol": "pnpm --filter @nova/runner-protocol generate",
    "build:runner": "cargo build -p nova-runner",
    "example:coding-dashboard": "pnpm --filter @nova/coding-harness example:coding-dashboard"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@git-diff-view/react": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@nnova/harness": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/diff": "^5.2.3",
    "@types/node": "24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.3",
    "zod": "4.6.4"
  }
}
