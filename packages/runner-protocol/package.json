{
  "name": "@nova/runner-protocol",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "pbjs -p ../../proto -t json -o src/generated.json ../../proto/runner/v1/common.proto ../../proto/runner/v1/execution.proto ../../proto/runner/v1/runner.proto",
    "test": "node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "protobufjs-cli": "^1.1.3",
    "typescript": "~5.9.3"
  }
}
