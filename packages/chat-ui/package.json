{
  "name": "@nova/chat-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat.tsx",
    "./composer": "./src/composer.tsx",
    "./styles.css": "./src/styles.css",
    "./message-list": "./src/message-list.tsx",
    "./remote-explorer": "./src/remote-explorer.tsx"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts demo --port 4175",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:boundaries": "node scripts/boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@git-diff-view/react": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "@nova/agent-ui-contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/diff": "^5.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.3"
  }
}
