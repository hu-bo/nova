{
  "name": "@nova/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness-entry.d.ts",
      "import": "./dist/harness-entry.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@nnova/harness": "workspace:*",
    "@nova/runner-sdk": "workspace:*",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
