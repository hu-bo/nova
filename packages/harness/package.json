{
  "name": "@nnova/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "插件化进程内 Agent 与 Task 框架（目录和 Coding 场景测试优先）",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*/index.d.ts",
      "import": "./dist/plugins/*/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/test.mjs",
    "lint": "eslint src tests",
    "check:boundaries": "node scripts/boundaries.mjs",
    "test:coding": "node --import tsx --test --test-concurrency=1 tests/scenarios/coding.scenario.test.ts",
    "format": "prettier --write src tests examples scripts eslint.config.mjs README.md docs/TESTING.md docs/IMPLEMENTATION_TASKS.md package.json tsconfig*.json",
    "format:check": "prettier --check src tests examples scripts eslint.config.mjs README.md docs/TESTING.md docs/IMPLEMENTATION_TASKS.md package.json tsconfig*.json"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.53",
    "@ai-sdk/deepseek": "3.0.44",
    "@ai-sdk/openai": "4.0.66",
    "@ai-sdk/openai-compatible": "3.0.48",
    "ai": "7.0.99",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
