{
  "name": "@nova/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --no-cache",
    "test:live-model": "cross-env NOVA_TEST_LIVE=1 vitest run --no-cache test/live-model.integration.test.ts"
  },
  "dependencies": {
    "@nova/agent-core": "workspace:*"
  },
  "devDependencies": {
    "@nova/model-adapters": "workspace:*",
    "cross-env": "^10.1.0",
    "vitest": "^2.1.3"
  }
}
